{
  "$comment": "自由に足す段の補足の事実（自由な項目と引き継ぎの模擬評価）。調整用の会社だけに置く。「ほかに引き継ぐもの」に挙げる物と、その種類と中身",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company",
    "purpose",
    "rules",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "answer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-\\d{2}$"
          },
          "kind": {
            "enum": [
              "device",
              "contact",
              "routine",
              "out_of_scope"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "answer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
